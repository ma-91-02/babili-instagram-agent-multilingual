    "1": "(?:كلف(?:ني|تني|نا|تنا)|خسر(?:ت|نا|ني)|ضيع(?:ت|نا))[^.!؟?]{0,30}\\d|\\d[\\d,٬.]*\\s*(?:دولار|دينار|ليرة|روبل|ألف|الف|مليون)[^.!؟?]{0,20}(?:كلف|خسر|ضيع)",
