    "structures": [
      {"id": "not-just", "regex": "(?:ليس|ليست|مو|مش|موب)\\s+(?:مجرد|بس)\\s+[^.!؟?\\n]{2,60}[،,.]?\\s*(?:بل|إنما|انما|لكنه|لكنها|هو|هي)\\b", "name": "«ليس مجرد X، بل Y» (\"It's not just X, it's Y\")", "fix": "Say the one thing you actually mean. Delete the setup half."},
      {"id": "not-only", "regex": "(?:ليس|لا)\\s+فقط\\b[^.!؟?\\n]{2,80}\\b(?:بل\\s+(?:أيضاً|أيضا|ايضا)|وإنما|وانما)", "name": "«ليس فقط X بل أيضاً Y» (\"Not only X but also Y\")", "fix": "Split into two sentences, or drop the weaker half."},
      {"id": "isnt-about", "regex": "(?:الموضوع|الأمر|الامر|القصة|القصه)\\s+(?:ليس|مو|مش)\\s+[^.!؟?\\n]{2,40}[.!،,]\\s*(?:الموضوع|الأمر|الامر|القصة|القصه)\\b", "name": "«الموضوع مو X، الموضوع Y» (\"It isn't about X. It's about Y.\")", "fix": "Lead with Y. The reversal is the tell."},
      {"id": "the-result", "regex": "^\\s*(?:النتيج[ةه]|الأحلى|الاحلى|المفاجأ[ةه]|المفاجا[ةه]|السر)\\s*[؟?]\\s*$", "name": "One-word rhetorical question line", "fix": "Answer it inline instead of staging a reveal."},
      {"id": "triad", "regex": "[^\\s،,]+،\\s*[^\\s،,]+،?\\s*و[^\\s.!]+[.!]", "name": "Rule-of-three triad (X، Y، وZ.)", "fix": "Two items or four. Three is the model's default rhythm."},
      {"id": "in-this-video", "regex": "(?:في|ب)\\s*(?:هذا|هاي|هذه|هذي|هال)\\s*(?:الفيديو|الريل|المقطع)|فيديو\\s+اليوم|اليوم\\s+(?:راح|رح|سوف)\\s*(?:نحچي|نحكي|نتكلم|نتحدث)|[أا]هلا[ًا]?\\s+بكم\\s+في", "name": "Video preamble («في هذا الفيديو راح نحچي عن»)", "fix": "Delete it and start at the payoff. The first two seconds decide the whole reel."},
      {"id": "stop-scroll", "regex": "^\\s*(?:لا\\s+تمرر|وقف\\s+التمرير|توقف\\s+عن\\s+التمرير|لا\\s+تسكرول|لا\\s+تقلب|وقف\\s+لحظ[ةه])", "name": "\"Stop scrolling\" opener («لا تمرر»)", "fix": "The scroll-stop has to be the claim itself. Asking for attention is the tell that you have not earned it."},
      {"id": "follow-bait", "regex": "تابعونا\\s+للمزيد|تابعنا\\s+للمزيد|اعمل(?:وا)?\\s+منشن|منشن\\s+(?:لصديقك|لشخص|لحد|لاحد)|شارك(?:ها|ه|وا)?\\s+مع\\s+(?:من\\s+تحب|[أا]صدقائك|صديقك|ربعك)|لا\\s+تنس(?:ى|وا|ي)?\\s+(?:اللايك|المتابع[ةه]|الإعجاب|الاعجاب)", "name": "Reflex follow or tag bait («تابعونا للمزيد»، «منشن لصديقك»)", "fix": "Ask for the one action this post actually earns. The generic ask trains the audience to ignore every ask."},
      {"id": "engagement-bait", "regex": "(?:مين|من)\\s+(?:مثلي|يوافقني)\\s*[؟?]?\\s*$|(?:شو|ما|شنو)\\s+ر[أا]يكم\\s*[؟?]\\s*$|صح\\s+ولا\\s+لا\\s*[؟?]?\\s*$", "name": "Reflex engagement bait («شو رأيكم؟»)", "fix": "Ask a question only you could ask, about the specific thing above it."},
      {"id": "in-summary", "regex": "^\\s*(?:في\\s+الختام|وفي\\s+الختام|ختاماً|ختاما|خلاص[ةه]\\s+القول)", "name": "Essay-closer opener («في الختام»)", "fix": "A post does not need a conclusion paragraph."},
      {"id": "as-an-ai", "regex": "بصفتي\\s+(?:نموذج|ذكاء\\s+اصطناعي)|كنموذج\\s+لغوي|ك(?:ذكاء|نموذج)\\s+اصطناعي", "name": "Model self-reference", "fix": "Delete the sentence."}
    ]
  },

