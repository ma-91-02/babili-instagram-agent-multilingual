    "15": "(?:[أا]ول)\\s+\\d+\\s+(?:فيديو|ريل|منشور|بوست|عميل|زبون|شهر|محاول[ةه])",
    "16": "^\\s*[«\"“]?(?:شلون|شنو|ليش|اشلون|كيف|ليه|إيش|ايش|شو|متى|وين|منو|مين|هل)\\b[^؟?]{3,110}[؟?]",
