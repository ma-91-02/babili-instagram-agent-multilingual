    "imperatives": [
      "хватит", "стоп", "сохрани*", "смотри*", "попробуй*", "удали*", "используй*",
      "запомни*", "забирай*", "пиши", "напиши*", "начни*", "никогда", "всегда", "не",
      "сделай*", "проверь*", "брось*", "нанеси*", "распыли*", "протри*", "перестань*"
    ],
    "address": {
      "you": [
        "ты", "тебе", "тебя", "тобой", "твой*", "твоя", "твое", "твои", "вы", "вам", "вас",
        "вами", "ваш*", "у тебя", "у вас"
      ],
      "you_suffixes": ["ешь", "ишь", "йте"],
      "you_exceptions": ["лишь", "мышь", "тишь", "вишь", "сайте", "кувейте"],
      "me": [
