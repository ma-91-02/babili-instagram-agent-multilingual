    },
    "dealbreakers": [
      {"type": "stop", "regex": "(?i)^\\s*(?:стоп\\b|не\\s+листай|не\\s+пролистывай|не\\s+скролл?ь|остановись)"},
      {"type": "preamble", "regex": "(?i)\\bв\\s+(?:этом|сегодняшнем)\\s+(?:видео|ролике|рилсе|выпуске)\\b|\\bсегодня\\s+(?:я\\s+)?(?:покажу|расскажу)\\b|\\bя\\s+(?:вам\\s+)?покажу\\b"},
      {"type": "greeting", "regex": "(?i)^\\s*(?:привет\\w*|всем\\s+привет|здравствуйте|добрый\\s+(?:день|вечер)|доброе\\s+утро|хай)\\b"}
    ]
  },

  "beats": {
