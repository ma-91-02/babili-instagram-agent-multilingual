  "caption": {
    "asks": [
      {"name": "comment a keyword", "regex": "(?i)\\b(?:напиши|напишите|пиши|пишите|оставь|оставьте|ставь|ставьте)\\b[^.!?\\n]{0,30}\\bкоммент\\w*"},
      {"name": "DM me", "regex": "(?i)(?:пиши(?:те)?\\s+(?:в\\s+)?(?:директ|личк\\w|лс|direct)|\\bв\\s+директ\\b|\\bв\\s+личные\\s+сообщения\\b)"},
      {"name": "save this", "regex": "(?i)\\bсохран(?:и|яй|ите|яйте)\\b"},
      {"name": "share this", "regex": "(?i)\\b(?:поделись|поделитесь|перешли|перешлите|отправь|отправьте)\\b"},
      {"name": "follow", "regex": "(?i)\\bподпис(?:ывайся|ывайтесь|ись|итесь)\\b"},
      {"name": "link in bio", "regex": "(?i)\\bссылк\\w*\\s+в\\s+(?:шапке|профиле|био)\\b"},
      {"name": "swipe or tap", "regex": "(?i)\\b(?:листай|листайте|смахни|смахните|свайп\\w*)\\b"},
      {"name": "answer a question", "regex": "(?i)\\b(?:а\\s+вы|а\\s+ты|какой\\s+вариант|что\\s+выберете|расскажите|напишите,?\\s+как)\\b"}
    ],
    "filler_tags": [
      "#рекомендации", "#рек", "#реки", "#врек", "#вреки", "#хочуврек", "#хочувтоп", "#лайк",
      "#подписка", "#взаимныелайки", "#explore", "#viral"
    ]
  },

  "voice": {
    "pronoun_target": 6.0
  },

  "lexicon": {
    "words": [
      {"find": "уникальн*", "replace": null, "family": "adjectives"},
      {"find": "революционн*", "replace": null, "family": "adjectives"},
      {"find": "инновационн*", "replace": null, "family": "adjectives"},
      {"find": "потрясающ*", "replace": null, "family": "adjectives"},
      {"find": "незаменим*", "replace": null, "family": "adjectives"},
      {"find": "волшебн*", "replace": null, "family": "adjectives"},
      {"find": "является", "replace": null, "family": "verbs"},
      {"find": "являются", "replace": null, "family": "verbs"},
      {"find": "играет ключевую роль", "replace": null, "family": "verbs"},
      {"find": "на новый уровень", "replace": null, "family": "verbs"},
      {"find": "с легкостью", "replace": "легко", "family": "adverbs"},
      {"find": "без особых усилий", "replace": "без усилий", "family": "adverbs"},
      {"find": "в мгновение ока", "replace": "быстро", "family": "adverbs"},
      {"find": "раз и навсегда", "replace": null, "family": "adverbs"},
      {"find": "таким образом", "replace": "так что", "family": "connectives"},
      {"find": "незаменимый помощник", "replace": "помощник", "family": "nouns"},
      {"find": "незаменимым помощником", "replace": "помощником", "family": "nouns"}
    ],
    "phrases": [
      {"find": "в современном мире", "replace": "", "family": "openers"},
      {"find": "в сегодняшнем быстро меняющемся мире", "replace": "", "family": "openers"},
      {"find": "в нашем быстро меняющемся мире", "replace": "", "family": "openers"},
      {"find": "в эпоху цифровых технологий", "replace": "", "family": "openers"},
