{
  "name": "Russian",
  "native": "Русский",
  "note": "Russian is heavily inflected, so most word lists use stems: an entry ending in '*' matches every ending ('потерял*' covers потерял, потеряла, потеряли). Ё and Е are treated as the same letter. The Russian dash (тире) and «ёлочки» quotes are correct house style here and are never stripped or counted as a machine tell. Thresholds are first estimates, not measured on a corpus. Edit freely.",
  "rtl": false,
  "cased": true,
  "sentence_end": ".!?…",
  "wpm": 140,
  "hook_words": [4, 10],
  "hook_chars": 70,
  "typography_native": ["—", "–", "«", "»", "„", "“"],

  "numbers": {
    "spoken": [
      "ноль", "два", "две", "три", "четыре", "пять", "шесть", "семь", "восемь", "девять",
      "десять", "двадцать", "тридцать", "сорок", "пятьдесят", "сто", "тысяч*", "миллион*",
      "миллиард*", "половин*", "вдвое", "втрое", "дважды", "трижды"
    ],
    "money": [
      "рубл*", "руб", "доллар*", "евро", "бакс*", "процент*", "зарплат*", "прибыл*",
      "выручк*", "бесплатн*", "цен*", "стоимост*", "скидк*"
    ]
  },

