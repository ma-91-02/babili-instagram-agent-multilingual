      "жаль", "нельзя", "должн*", "уже", "еще", "только", "без", "против", "но", "кроме",
      "вместо", "пока", "перед", "бесплатно", "первый", "первые", "впервые", "реально",
      "вообще", "испортил*", "царапин*", "развод*"
    ],
    "weak_openers": [
