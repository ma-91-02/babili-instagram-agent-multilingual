      {"find": "подписывайтесь, чтобы не пропустить", "replace": null, "family": "instagram"},
      {"find": "подписывайся, чтобы не пропустить", "replace": null, "family": "instagram"},
      {"find": "ставьте лайк", "replace": "", "family": "instagram"},
      {"find": "ставь лайк", "replace": "", "family": "instagram"},
      {"find": "сохраняй, чтобы не потерять", "replace": "сохрани", "family": "instagram"},
      {"find": "сохраняйте, чтобы не потерять", "replace": "сохраните", "family": "instagram"},
      {"find": "сохрани, чтобы не потерять", "replace": "сохрани", "family": "instagram"}
    ],
    "structures": [
      {"id": "not-just", "regex": "(?i)\\bэто\\s+не\\s+(?:просто|только)\\b[^.!?\\n]{2,60}[,—–-]\\s*(?:а|это)\\b", "name": "«Это не просто X, а Y» (\"It's not just X, it's Y\")", "fix": "Say the one thing you actually mean. Delete the setup half."},
      {"id": "not-only", "regex": "(?i)\\bне\\s+только\\b[^.!?\\n]{2,80}\\bно\\s+и\\b", "name": "«Не только X, но и Y» (\"Not only X but also Y\")", "fix": "Split into two sentences, or drop the weaker half."},
      {"id": "isnt-about", "regex": "(?i)\\bдело\\s+не\\s+в\\b[^.!?\\n]{2,60}[.!,]\\s*(?:дело\\s+в|а\\s+в)\\b", "name": "«Дело не в X. Дело в Y.»", "fix": "Lead with Y. The reversal is the tell."},
      {"id": "the-result", "regex": "(?im)^\\s*(?:результат|итог|фишка|секрет|главное)\\?\\s*$", "name": "One-word rhetorical question line", "fix": "Answer it inline instead of staging a reveal."},
      {"id": "triad", "regex": "(?i)\\b\\w+,\\s\\w+\\s+и\\s+\\w+\\.", "name": "Rule-of-three triad (X, Y и Z.)", "fix": "Two items or four. Three is the model's default rhythm."},
      {"id": "in-this-video", "regex": "(?i)\\bв\\s+(?:этом|сегодняшнем)\\s+(?:видео|ролике|рилсе|посте)\\b|\\bсегодня\\s+(?:я\\s+)?(?:расскажу|покажу)\\b|\\bвсем\\s+привет\\b", "name": "Video preamble («в этом видео я покажу»)", "fix": "Delete it and start at the payoff. The first two seconds decide the whole reel."},
      {"id": "stop-scroll", "regex": "(?im)^\\s*(?:стоп\\b|не\\s+листай|не\\s+пролистывай|остановись)", "name": "\"Stop scrolling\" opener («не листай»)", "fix": "The scroll-stop has to be the claim itself. Asking for attention is the tell that you have not earned it."},
      {"id": "follow-bait", "regex": "(?i)\\b(?:подписывайся|подписывайтесь|ставь(?:те)?\\s+лайк|отметь(?:те)?\\s+(?:друга|подругу|того|ту)|поделись\\s+с\\s+тем)\\b", "name": "Reflex follow or tag bait («подписывайтесь», «отметь подругу»)", "fix": "Ask for the one action this post actually earns. The generic ask trains the audience to ignore every ask."},
      {"id": "engagement-bait", "regex": "(?im)(?:согласны\\?|а\\s+вы\\s+как\\s+думаете\\?|кто\\s+со\\s+мной\\?|кто\\s+тоже\\?)\\s*$", "name": "Reflex engagement bait («согласны?»)", "fix": "Ask a question only you could ask, about the specific thing above it."},
      {"id": "in-summary", "regex": "(?im)^\\s*(?:в\\s+заключение|подводя\\s+итоги?|итак,\\s+подведем)\\b", "name": "Essay-closer opener («в заключение»)", "fix": "A post does not need a conclusion paragraph."},
      {"id": "as-an-ai", "regex": "(?i)\\bкак\\s+(?:ии|языковая\\s+модель|искусственный\\s+интеллект)\\b", "name": "Model self-reference", "fix": "Delete the sentence."},
      {"id": "caps-shout", "regex": "\\b[А-ЯЁ]{3,}\\b(?:\\s+\\b[А-ЯЁ]{3,}\\b){2,}", "name": "Three or more shouted words in a row", "fix": "Caps are a volume knob, not a highlighter. One word, at most."}
    ]
  },

  "hook_match": {
    "1": "\\b(?:стоил[аио]?|обошл(?:ась|ось|ся))\\s+(?:мне|нам)\\b|\\bпотерял[аи]?\\b[^.!?]{0,25}\\d|\\d[\\d\\s,.]*\\s*(?:₽|руб|\\$|долл|тыс)[^.!?]{0,20}\\b(?:стоил|потерял)",
    "2": "^\\s*(?:хватит|перестань(?:те)?|прекрати(?:те)?|никогда\\s+не|не\\s+(?:покупай|используй|делай|мой|трать|наноси)\\w*)\\b",
    "3": "\\b(?:никто|никто\\s+никогда)\\s+(?:вам\\s+|тебе\\s+)?не\\s+(?:говорит|скажет|рассказывает|расскажет|предупреждает|говорил)\\b|\\bо\\s+ч[её]м\\s+(?:молчат|никто\\s+не\\s+говорит)\\b",
    "5": "\\bраньше\\s+(?:это\\s+|у\\s+меня\\s+)?(?:занимал[оа]?|уходил[оа]?)\\b|\\b(?:теперь|сейчас)\\s+(?:это\\s+)?(?:занимает|уходит)\\b|\\bза\\s+\\d+\\s*(?:сек|секунд|мин|минут)\\w*",
    "7": "\\b(?:главная|самая\\s+частая|частая|типичная)\\s+ошибка\\b|\\b(?:ты|вы)\\s+(?:делаешь|моешь|чистишь|используешь|делаете|моете|чистите|используете)\\b[^.!?]*\\bнеправильно\\b",
    "9": "^\\s*(?:сохран(?:и|яй|ите)|забирай(?:те)?|воруй(?:те)?|кради(?:те)?|запомни(?:те)?)\\b",
    "10": "^\\s*если\\s+(?:ты|вы|у\\s+тебя|у\\s+вас|ваш|твой|твоя|ваша)\\b",
    "11": "^\\s*\\d+\\s+\\w+|\\b(?:номер|пункт)\\s+\\d+\\b|^\\s*(?:три|четыре|пять|семь|десять)\\s+\\w+",
    "15": "\\b(?:мои\\s+)?первы[ехй]\\s+\\d+\\s+\\w+",
    "16": "^\\s*[«\"„]?(?:как|что|почему|зачем|когда|где|кто|какой|какая|какое|можно\\s+ли|стоит\\s+ли|нужно\\s+ли|правда\\s+ли)\\b[^?]{3,110}\\?",
    "17": "\\b(?:vs\\.?|против|versus)\\b|\\bразниц[аы]\\s+между\\b|\\bсравни(?:ли|л|м|ваем)\\b",
    "18": "^\\s*(?:смотри(?:те)?|глянь(?:те)?|сейчас\\s+покажу|давай(?:те)?\\s+покажу|повторяй(?:те)?\\s+за\\s+мной)\\b",
    "20": "\\b(?:тебе|вам)\\s+не\\s+(?:нужн[оаы]?|нужен|обязательно|надо)\\b|\\bне\\s+обязательно\\b",
    "23": "^\\s*\\d[\\d\\s,.]*\\s?%|\\b\\d[\\d,.]*\\s?%\\s+(?:людей|россиян|хозяек|из)\\b",
    "24": "^\\s*(?:это|вот)\\s+(?:новый|новая|новое|новые|мой\\s+новый|моя\\s+новая)\\b",
    "26": "^\\s*(?:самый|самая|самое|самые)\\s+(?:быстр|прост|лучш|эффективн|легк|дешев)\\w*|\\b(?:единственный|самый\\s+быстрый|самый\\s+простой|лучший)\\s+способ\\b"
  }
}
